POSTGRES_PASSWORD=   #eg: 123456
POSTGRES_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/<database>   #eg: crawler


CLICKHOUSE_USER=       #eg: default
CLICKHOUSE_PASSWORD=   #eg: 123456
CLICKHOUSE_URL=clickhouse+http://${CLICKHOUSE_USER}:${CLICKHOUSE_PASSWORD}@localhost:8123/<database>   #eg: warehouse