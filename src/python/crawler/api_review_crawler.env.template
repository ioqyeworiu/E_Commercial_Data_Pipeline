KAFKA_BROKER=kafka-1:9092
KAFKA_TOPIC=data_crawled_v2
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_REPLICATION=1

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@pg-crawler-db:5432/crawler

# số thread cào song song, mỗi thread nghỉ REQUEST_DELAY giây giữa 2 request
WORKERS=2
BATCH_SIZE=50
REQUEST_DELAY=0.5
REQUEST_TIMEOUT=15

# số review tối đa trong 1 message Kafka (~1KB/review)
REVIEWS_PER_MESSAGE=1000
# lùi mốc created_at bao nhiêu giờ khi cào incremental (bắt review được duyệt muộn)
REVIEW_OVERLAP_HOURS=72
# lịch cào review (phút): bắt đầu 60, x2 khi không có review mới, /2 khi có
REVIEW_INITIAL_INTERVAL=60
REVIEW_MIN_INTERVAL=30
REVIEW_MAX_INTERVAL=1440
# bao lâu quét crawl_state để thêm URL mới vào review_crawl_state (giây)
SEED_INTERVAL_SEC=600

# cache (spid, seller_id) cho API tóm tắt AI (giây)
ENTITY_CACHE_TTL_SEC=3600

