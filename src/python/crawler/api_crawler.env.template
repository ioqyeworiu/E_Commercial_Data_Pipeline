KAFKA_BROKER=kafka-1:9092
KAFKA_TOPIC=data_crawled_v2
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_REPLICATION=1

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@pg-crawler-db:5432/crawler

# số thread cào song song, mỗi thread nghỉ REQUEST_DELAY giây giữa 2 request
WORKERS=2
BATCH_SIZE=100
REQUEST_DELAY=0.5
REQUEST_TIMEOUT=15

# 20 review / trang, lấy mới nhất trước
MAX_REVIEW_PAGES=5

# cache seller / store / brand trong RAM (giây)
ENTITY_CACHE_TTL_SEC=3600

# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36 Edg/130.0.0.0
